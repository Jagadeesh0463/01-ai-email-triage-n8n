    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const e = item.json;\n  return {\n    json: {\n      messageId: e.id,\n      from: e.from || '',\n      subject: e.subject || '',\n      bodyText: (e.snippet || '').slice(0, 2000)\n    }\n  };\n});"
      },
      "id": "113e13c5-59a5-4726-a402-c625061bd2cd",
      "name": "Clean Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        688,
        -32
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const original = item.json;\n  let raw = original.output || '';\n\n  // Extract JSON safely\n  const match = raw.match(/\\{[\\s\\S]*?\\}/);\n\n  let parsed;\n\n  try {\n    parsed = match ? JSON.parse(match[0]) : null;\n\n    if (!parsed || !parsed.category) {\n      throw new Error();\n    }\n  } catch (e) {\n    parsed = {\n      category: 'FYI',\n      summary: original.subject || 'No summary',\n      priority_score: 1\n    };\n  }\n\n  return {\n    json: {\n      ...original,\n      ...parsed\n    }\n  };\n});"
      },
      "id": "9de0359b-199f-48df-adc8-21ee55f1eb26",
      "name": "Parse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        -32
      ]
    },
    {
      "parameters": {
        "jsCode": "items.sort((a, b) => b.json.priority_score - a.json.priority_score);\n\nconst urgent = items.filter(i => i.json.category === 'Urgent').length;\nconst follow = items.filter(i => i.json.category === 'Follow-up').length;\nconst fyi = items.filter(i => i.json.category === 'FYI').length;\n\nconst lines = items.map(item => {\n  return `🔹 ${item.json.category}: ${item.json.summary}`;\n});\n\nreturn [{\n  json: {\n    digest:\n`📧 Email Digest\n\nUrgent: ${urgent}\nFollow-up: ${follow}\nFYI: ${fyi}\n\n${lines.join('\\n')}`\n  }\n}];"
      },
      "id": "2c3e3248-ec58-46b1-a8ea-7810322a5faf",
      "name": "Create Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1824,
        -32
      ]
    },
