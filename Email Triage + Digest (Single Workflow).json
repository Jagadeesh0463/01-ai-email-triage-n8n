    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=/no_think\n\nYou are an AI email triage assistant.\n\nClassify this email into ONLY one category:\n\n* Urgent\n* Follow-up\n* FYI\n\nRules:\n\n* Fraud alerts, security alerts, failed payments, client escalations → Urgent\n* Transactions, invoices, pending replies, interview emails → Follow-up\n* Promotions, newsletters, updates → FYI\n* Ignore automated digest emails\n\nReturn ONLY valid JSON.\n\nFormat:\n{\n\"category\": \"Urgent\",\n\"summary\": \"short summary under 8 words\",\n\"priority_score\": 1\n}\n\nEmail:\nFrom: {{$json.from}}\nSubject: {{$json.subject}}\nBody: {{$json.bodyText}}\n",
        "options": {}
      },
